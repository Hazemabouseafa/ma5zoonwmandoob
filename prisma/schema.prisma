generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  rep
}

enum ProductCategory {
  dairy
  juice
}

enum BatchStatus {
  active
  expiring_soon
  expired
  depleted
}

enum PaymentType {
  cash
  credit
}

enum ReturnReason {
  expired
  damaged
}

enum SettlementStatus {
  balanced
  discrepancy
}

model User {
  id          String         @id @default(uuid())
  name        String
  username    String         @unique
  password    String
  role        Role           @default(rep)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invoices     Invoice[]
  returns      Return[]
  collections  Collection[]
  settlements  Settlement[]
  repInventory RepInventory[]

  @@map("users")
}

model Category {
  id                   String   @id @default(uuid())
  name                 String   @unique
  defaultShelfLifeDays Int      @default(1)
  createdAt            DateTime @default(now())

  @@map("categories")
}

model Product {
  id             String          @id @default(uuid())
  name           String
  category       String          @default("ألبان") // Custom category name
  shelfLifeDays  Int             @default(1)
  price          Float
  cost           Float
  unit           String          @default("كرتونة")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  batches        InventoryBatch[]
  repInventories RepInventory[]
  invoiceItems   InvoiceItem[]
  returns        Return[]

  @@map("products")
}

model InventoryBatch {
  id              String      @id @default(uuid())
  productId       String
  batchNumber     String      @unique
  initialQuantity Int
  quantity        Int         // Main warehouse remaining stock
  productionDate  DateTime
  expiryDate      DateTime
  status          BatchStatus @default(active)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  repInventories  RepInventory[]
  invoiceItems    InvoiceItem[]

  @@map("inventory_batches")
}

model RepInventory {
  id          String         @id @default(uuid())
  repId       String
  productId   String
  batchId     String
  quantity    Int            // Quantity in rep's vehicle
  updatedAt   DateTime       @updatedAt

  rep         User           @relation(fields: [repId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([repId, batchId])
  @@map("rep_inventory")
}

model Client {
  id            String       @id @default(uuid())
  name          String
  phone         String?
  address       String?
  creditBalance Float        @default(0.0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invoices    Invoice[]
  collections Collection[]

  @@map("clients")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  repId         String
  clientId      String
  subtotal      Float         @default(0.0)
  discount      Float         @default(0.0)
  totalAmount   Float         // Net total after discount
  paidAmount    Float
  paymentType   PaymentType   @default(cash)
  notes         String?
  createdAt     DateTime      @default(now())

  rep           User          @relation(fields: [repId], references: [id])
  client        Client        @relation(fields: [clientId], references: [id])
  items         InvoiceItem[]
  returns       Return[]

  @@map("invoices")
}

model InvoiceItem {
  id          String         @id @default(uuid())
  invoiceId   String
  productId   String
  batchId     String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  batch       InventoryBatch @relation(fields: [batchId], references: [id])

  @@map("invoice_items")
}

model Return {
  id          String       @id @default(uuid())
  repId       String
  invoiceId   String?
  productId   String
  quantity    Int
  reason      ReturnReason
  notes       String?
  createdAt   DateTime     @default(now())

  rep         User         @relation(fields: [repId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])

  @@map("returns")
}

model Collection {
  id        String   @id @default(uuid())
  repId     String
  clientId  String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  rep       User     @relation(fields: [repId], references: [id])
  client    Client   @relation(fields: [clientId], references: [id])

  @@map("collections")
}

model Settlement {
  id                 String           @id @default(uuid())
  repId              String
  date               DateTime         @default(now())
  expectedCash       Float
  actualCash         Float
  cashDifference     Float            @default(0.0)
  stockDiscrepancies String?          // JSON description of any item discrepancies
  status             SettlementStatus @default(balanced)
  notes              String?
  createdAt          DateTime         @default(now())

  rep                User             @relation(fields: [repId], references: [id])

  @@map("settlements")
}
